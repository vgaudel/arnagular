      "versionNonce": 784668915,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791443767340,
      "link": null,
      "locked": false,
      "text": "Lorque l'on veut faire communiquer plusieurs components entre eux, on ne suit plus la hiérarchie\ndes composants, mais on partage plutôt des services.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lorque l'on veut faire communiquer plusieurs components entre eux, on ne suit plus la hiérarchie\ndes composants, mais on partage plutôt des services.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
