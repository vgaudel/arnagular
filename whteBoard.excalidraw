      "text": "ZoneJS :\nsurveillait en permanence les changements \nd'état de l'application et relançait le rendering\n\nAllourdi énormément l'appli avec des traitements \nimportants en local",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ZoneJS :\nsurveillait en permanence les changements \nd'état de l'application et relançait le rendering\n\nAllourdi énormément l'appli avec des traitements \nimportants en local",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NXUL3kCb18NUkeckMeHqL",
      "type": "text",
      "x": 303.5649454800878,
      "y": 5346.368040965895,
      "width": 919.9994506835938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
